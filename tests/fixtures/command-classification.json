{
  "schema_version": 1,
  "about": "Shared polling and recipe classification cases. nenpi tests and management-plane scripts/burn-governor (which vendors this file) must both pass every case. Contract and rules: docs/polling.md. Cases assert classification only, never normalized signatures.",
  "schema": {
    "defaults": "threshold and window_steps used unless a case sets options",
    "cases[].steps": "ordered tool calls in one thread and one prompt",
    "cases[].steps[].tool": "harness tool name; Bash is a shell step, Edit/Write/MultiEdit/NotebookEdit/apply_patch are writes, exec with input.code is one Codex code-mode call, anything else is a generic tool",
    "cases[].steps[].command": "shell steps only: the literal command text",
    "cases[].steps[].cwd": "shell steps only: working directory",
    "cases[].steps[].input": "non-shell steps only: the tool input object",
    "cases[].steps[].result": "optional tool-result text; absent means unknown",
    "cases[].expect": "one classification per step, judged before that step runs: {polling: bool, kind: pure_poll|watch|none, recipe_id: wait-for-status|merge-pr-when-green|query-logs|null}"
  },
  "defaults": {"threshold": 3, "window_steps": 30},
  "recipes": {
    "wait-for-status": "scripts/wait-for-status",
    "merge-pr-when-green": "scripts/merge-pr-when-green",
    "query-logs": "scripts/query-logs"
  },
  "cases": [
    {
      "name": "ci-checks-identical-results-pure-poll",
      "steps": [
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo", "result": "build\tpending\ntest\tpending"},
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo", "result": "build\tpending\ntest\tpending"},
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo"}
      ],
      "expect": [
        {"polling": false, "kind": "none", "recipe_id": null},
        {"polling": false, "kind": "none", "recipe_id": null},
        {"polling": true, "kind": "pure_poll", "recipe_id": "wait-for-status"}
      ]
    },
    {
      "name": "ci-checks-changing-results-watch",
      "steps": [
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo", "result": "build\tpending\ntest\tpending"},
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo", "result": "build\tpass\ntest\tpending"},
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo", "result": "build\tpass\ntest\tpass"},
        {"tool": "Bash", "command": "gh pr checks 12", "cwd": "/repo"}
      ],
      "expect": [
        {"polling": false, "kind": "none", "recipe_id": null},
        {"polling": false, "kind": "none", "recipe_id": null},
        {"polling": true, "kind": "watch", "recipe_id": "wait-for-status"},
        {"polling": true, "kind": "watch", "recipe_id": "wait-for-status"}
      ]
    },
    {
      "name": "ci-elapsed-time-digits-do-not-count-as-change",
